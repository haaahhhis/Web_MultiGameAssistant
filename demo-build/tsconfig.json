{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": [],
    "ignoreDeprecations": "6.0",
    "paths": {
      "@adg/protocol": ["../../MultiGameAssistant/packages/protocol/src/index.ts"],
      "@adg/*": ["../../MultiGameAssistant/packages/*/src/index.ts"],
      "@mga-web/*": ["../../MultiGameAssistant/apps/web/src/*"]
    }
  },
  "include": ["entry.ts", "gateway/**/*.ts", "scenarios/**/*.ts"]
}
